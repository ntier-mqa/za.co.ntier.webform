				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["The MQA wishes to support the development of employees for the Mining and Minerals Sector in the management field."]]></textFieldExpression>
