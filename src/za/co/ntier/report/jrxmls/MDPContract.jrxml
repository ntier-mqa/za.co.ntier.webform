				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[This Agreement constitutes the whole agreement between the parties and no party is bound by any express or implied term, representation, warranty, promise or the like not recorded in this Agreement]]></text>
