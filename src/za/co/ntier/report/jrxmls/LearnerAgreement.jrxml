		<band height="677" splitType="Stretch">
			<image scaleImage="RetainShape" hAlign="Center">
				<reportElement x="0" y="0" width="555" height="70" uuid="6cd82ae0-deec-4679-8f6d-7159df592453"/>
				<imageExpression><![CDATA[$P{REPORT_CLASS_LOADER}.getResourceAsStream("/za/co/ntier/report/jrxmls/Artisan_Agreement_Header.png")]]></imageExpression>
