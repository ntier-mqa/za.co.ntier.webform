			</frame>
			<frame>
				<reportElement positionType="Float" x="0" y="76" width="487" height="18" uuid="b1a2c3d4-0004-0001-0001-000000000028"/>
				<staticText>
					<reportElement x="0" y="0" width="115" height="18" uuid="b1a2c3d4-0004-0001-0001-000000000029"/>
					<textElement verticalAlignment="Top">
						<font size="11"/>
					</textElement>
					<text><![CDATA[Attention:]]></text>
				</staticText>
				<textField isBlankWhenNull="true" textAdjust="StretchHeight">
					<reportElement x="115" y="0" width="372" height="18" uuid="b1a2c3d4-0004-0001-0001-000000000030"/>
					<textElement verticalAlignment="Top">
						<font size="11"/>
					</textElement>
					<textFieldExpression><![CDATA[$P{ContractData} != null && $P{ContractData}.get("EmployerAttention") != null ? (String)$P{ContractData}.get("EmployerAttention") : ($P{ContractData} != null && $P{ContractData}.get("EmployerContact") != null ? (String)$P{ContractData}.get("EmployerContact") : $P{EmployerAttention})]]></textFieldExpression>
				</textField>
			</frame>
			<frame>
				<reportElement positionType="Float" x="0" y="100" width="487" height="18" uuid="b1a2c3d4-0004-0001-0001-000000000031"/>
				<staticText>
					<reportElement x="0" y="0" width="115" height="18" uuid="b1a2c3d4-0004-0001-0001-000000000032"/>
					<textElement verticalAlignment="Top">
						<font size="11"/>
					</textElement>
					<text><![CDATA[Contact:]]></text>
				</staticText>
				<textField isBlankWhenNull="true" textAdjust="StretchHeight">
					<reportElement x="115" y="0" width="372" height="18" uuid="b1a2c3d4-0004-0001-0001-000000000033"/>
					<textElement verticalAlignment="Top">
						<font size="11"/>
					</textElement>
					<textFieldExpression><![CDATA[$P{ContractData} != null && $P{ContractData}.get("EmployerContact") != null ? (String)$P{ContractData}.get("EmployerContact") : ($P{ContractData} != null && $P{ContractData}.get("EmployerTelephone") != null ? (String)$P{ContractData}.get("EmployerTelephone") : $P{EmployerContact})]]></textFieldExpression>
				</textField>
			</frame>
		</band>

		<!-- 5.2 - 5.4.5 -->
		<band height="26" splitType="Prevent">
			<staticText>
				<reportElement x="0" y="0" width="30" height="18" uuid="b1a2c3d4-0005-0002-0001-000000000001"/>
				<textElement verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<text><![CDATA[5.2.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="30" y="0" width="457" height="18" uuid="b1a2c3d4-0005-0003-0001-000000000001"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["Any notice or communication required or permitted to be given in terms of this Agreement is valid and effective only if in writing and delivered by pre-paid registered post, hand, telefax or e-mail."]]></textFieldExpression>
			</textField>
		</band>
		<band height="26" splitType="Prevent">
			<staticText>
				<reportElement x="0" y="0" width="30" height="18" uuid="b1a2c3d4-0005-0002-0001-000000000002"/>
				<textElement verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<text><![CDATA[5.3.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="30" y="0" width="457" height="18" uuid="b1a2c3d4-0005-0003-0001-000000000002"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["Any party may by notice to the other parties change its domicillium, provided that the change is effective vis-à-visa that addressee only 10 business days after receipt of the notice by the addressee,"]]></textFieldExpression>
			</textField>
		</band>
		<band height="26" splitType="Prevent">
			<staticText>
				<reportElement x="0" y="0" width="30" height="18" uuid="b1a2c3d4-0005-0002-0001-000000000003"/>
				<textElement verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<text><![CDATA[5.4.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="30" y="0" width="457" height="18" uuid="b1a2c3d4-0005-0003-0001-000000000003"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["Any notice to a party \u2013"]]></textFieldExpression>
			</textField>
		</band>
		<band height="26" splitType="Prevent">
			<staticText>
				<reportElement x="18" y="0" width="38" height="18" uuid="b1a2c3d4-0005-0002-0001-000000000004"/>
				<textElement verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<text><![CDATA[5.4.1.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="56" y="0" width="431" height="18" uuid="b1a2c3d4-0005-0003-0001-000000000004"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["sent by pre-paid registered post to the stipulated physical address is deemed to have been received 10 business days after posting (unless the contrary is proved);"]]></textFieldExpression>
			</textField>
		</band>
		<band height="26" splitType="Prevent">
			<staticText>
				<reportElement x="18" y="0" width="38" height="18" uuid="b1a2c3d4-0005-0002-0001-000000000005"/>
				<textElement verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<text><![CDATA[5.4.2.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="56" y="0" width="431" height="18" uuid="b1a2c3d4-0005-0003-0001-000000000005"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["delivered by hand to a responsible person at the stipulated physical address during ordinary business hours is deemed to have been received on the day of delivery;"]]></textFieldExpression>
			</textField>
		</band>
		<band height="26" splitType="Prevent">
			<staticText>
				<reportElement x="18" y="0" width="38" height="18" uuid="b1a2c3d4-0005-0002-0001-000000000006"/>
				<textElement verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<text><![CDATA[5.4.3.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="56" y="0" width="431" height="18" uuid="b1a2c3d4-0005-0003-0001-000000000006"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["Sent by telefax to the stipulated telefax number is deemed to have been received on the date of dispatch (unless the contrary is proved); or"]]></textFieldExpression>
			</textField>
		</band>
		<band height="26" splitType="Prevent">
			<staticText>
				<reportElement x="18" y="0" width="38" height="18" uuid="b1a2c3d4-0005-0002-0001-000000000007"/>
				<textElement verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<text><![CDATA[5.4.4.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="56" y="0" width="431" height="18" uuid="b1a2c3d4-0005-0003-0001-000000000007"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["sent by e-mail to the stipulated e-mail address is deemed to have been received on the date of dispatch (unless the contrary is proved)."]]></textFieldExpression>
			</textField>
		</band>
		<band height="26" splitType="Prevent">
			<staticText>
				<reportElement x="18" y="0" width="38" height="18" uuid="b1a2c3d4-0005-0002-0001-000000000008"/>
				<textElement verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<text><![CDATA[5.4.5.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="56" y="0" width="431" height="18" uuid="b1a2c3d4-0005-0003-0001-000000000008"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["Despite this clause, a written notice or communication actually received by a party is adequate written notice or communication to it notwithstanding that is was not sent to or delivered at its stipulated domicillium."]]></textFieldExpression>
			</textField>
		</band>

		<!-- SECTION 6 -->
		<band height="60" splitType="Prevent">
			<staticText>
				<reportElement x="0" y="10" width="24" height="18" uuid="b1a2c3d4-0005-0002-0001-000000000009"/>
				<textElement verticalAlignment="Top">
					<font size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[6.]]></text>
			</staticText>
			<staticText>
				<reportElement x="24" y="10" width="463" height="18" uuid="b1a2c3d4-0005-0003-0001-000000000009"/>
				<textElement verticalAlignment="Top">
					<font size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[Breach And Termination]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="34" width="30" height="18" uuid="b1a2c3d4-0005-0002-0001-000000000010"/>
				<textElement verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<text><![CDATA[6.1.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="30" y="34" width="457" height="18" uuid="b1a2c3d4-0005-0003-0001-000000000010"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["If any of the parties breaches or otherwise default on any of its obligations under this Agreement , or remain in default or fail to remedy such breach within 10 business days of receipts of a written notice calling upon it to do so, the other part is entitled, in addition to any other rights it may have, or remedies which may be available, to cancel this agreement forthwith, or to obtain an order for specific performance, or to claim damages together with any amounts owing under this Agreement ."]]></textFieldExpression>
			</textField>
		</band>
		<band height="52" splitType="Prevent">
			<staticText>
				<reportElement x="0" y="0" width="30" height="18" uuid="b1a2c3d4-0005-0002-0001-000000000011"/>
				<textElement verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<text><![CDATA[6.2.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="30" y="0" width="457" height="18" uuid="b1a2c3d4-0005-0003-0001-000000000011"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["In addition to any other legal remedies the parties may have, this Agreement may be terminated with immediate effect if a party commits a material breach of the Agreement."]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" x="30" y="26" width="457" height="18" uuid="b1a2c3d4-0005-0001-0001-000000000012"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["The following will amongst other constitute material breach of this Agreement \u2013"]]></textFieldExpression>
			</textField>
		</band>
		<band height="26" splitType="Prevent">
			<staticText>
				<reportElement x="18" y="0" width="38" height="18" uuid="b1a2c3d4-0005-0002-0001-000000000013"/>
				<textElement verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<text><![CDATA[6.2.1.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="56" y="0" width="431" height="18" uuid="b1a2c3d4-0005-0003-0001-000000000013"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["failure to comply with a party's obligations in terms of this agreement;"]]></textFieldExpression>
			</textField>
		</band>
		<band height="26" splitType="Prevent">
			<staticText>
				<reportElement x="18" y="0" width="38" height="18" uuid="b1a2c3d4-0005-0002-0001-000000000014"/>
				<textElement verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<text><![CDATA[6.2.2.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="56" y="0" width="431" height="18" uuid="b1a2c3d4-0005-0003-0001-000000000014"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["the Host Company is placed under the provisional or final liquidation; whether voluntary or compulsory, or is placed under judicial management;"]]></textFieldExpression>
			</textField>
		</band>
		<band height="26" splitType="Prevent">
			<staticText>
				<reportElement x="18" y="0" width="38" height="18" uuid="b1a2c3d4-0006-0002-0001-000000000001"/>
				<textElement verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<text><![CDATA[6.2.3.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="56" y="0" width="431" height="18" uuid="b1a2c3d4-0006-0003-0001-000000000001"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["failure to adhere to agreed time frames; or"]]></textFieldExpression>
			</textField>
		</band>
		<band height="26" splitType="Prevent">
			<staticText>
				<reportElement x="18" y="0" width="38" height="18" uuid="b1a2c3d4-0006-0002-0001-000000000002"/>
				<textElement verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<text><![CDATA[6.2.4.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="56" y="0" width="431" height="18" uuid="b1a2c3d4-0006-0003-0001-000000000002"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["use of the MQA grant funding for any purpose except for the purpose provided."]]></textFieldExpression>
			</textField>
		</band>

		<!-- SECTION 7 -->
		<band height="60" splitType="Prevent">
			<staticText>
				<reportElement x="0" y="10" width="24" height="18" uuid="b1a2c3d4-0006-0002-0001-000000000003"/>
				<textElement verticalAlignment="Top">
					<font size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[7.]]></text>
			</staticText>
			<staticText>
				<reportElement x="24" y="10" width="463" height="18" uuid="b1a2c3d4-0006-0003-0001-000000000003"/>
				<textElement verticalAlignment="Top">
					<font size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[Dispute Resolution]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="34" width="30" height="18" uuid="b1a2c3d4-0006-0002-0001-000000000004"/>
				<textElement verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<text><![CDATA[7.1.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="30" y="34" width="457" height="18" uuid="b1a2c3d4-0006-0003-0001-000000000004"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["Any dispute that arises between any of the parties in connection with the interpretation , application or termination of this Agreement must, unless resolved between the parties as contemplated below, be determined by arbitration in terms of this clause."]]></textFieldExpression>
			</textField>
		</band>
		<band height="26" splitType="Prevent">
			<staticText>
				<reportElement x="0" y="0" width="30" height="18" uuid="b1a2c3d4-0006-0002-0001-000000000005"/>
				<textElement verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<text><![CDATA[7.2.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="30" y="0" width="457" height="18" uuid="b1a2c3d4-0006-0003-0001-000000000005"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["Any party to the dispute may deliver a notice of dispute to the other parties for consideration by a committee consisting of nominated representatives of the parties in dispute, which must convene and use its best endeavors to resolve the dispute within 10 business days of delivery of the notice."]]></textFieldExpression>
			</textField>
		</band>
		<band height="26" splitType="Prevent">
			<staticText>
				<reportElement x="0" y="0" width="30" height="18" uuid="b1a2c3d4-0006-0002-0001-000000000006"/>
				<textElement verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<text><![CDATA[7.3.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="30" y="0" width="457" height="18" uuid="b1a2c3d4-0006-0003-0001-000000000006"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["If the committee is unable to meeting or to resolve the dispute within that period, any party to the dispute may by written notice to the other parties, setting out the particulars of the dispute, refer the dispute for arbitration under the auspices of the Arbitration Foundation of South Africa (\"AFSA\"), each party to pay its own costs and the costs of the arbitrator to be shared by the parties to the dispute."]]></textFieldExpression>
			</textField>
		</band>
		<band height="26" splitType="Prevent">
			<staticText>
				<reportElement x="0" y="0" width="30" height="18" uuid="b1a2c3d4-0006-0002-0001-000000000007"/>
				<textElement verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<text><![CDATA[7.4.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="30" y="0" width="457" height="18" uuid="b1a2c3d4-0006-0003-0001-000000000007"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["The arbitration must be held in Gauteng in accordance with the formalities and procedures determined by the arbitrator and, subject to exceptional circumstances, must be concluded within 20 business days of the arbitrator's appointment. Any decision (including an award) made by the arbitrator is final and binding on the parties and may be made an order of any court of competent jurisdiction."]]></textFieldExpression>
			</textField>
		</band>
		<band height="26" splitType="Prevent">
			<staticText>
				<reportElement x="0" y="0" width="30" height="18" uuid="b1a2c3d4-0006-0002-0001-000000000008"/>
				<textElement verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<text><![CDATA[7.5.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="30" y="0" width="457" height="18" uuid="b1a2c3d4-0006-0003-0001-000000000008"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["This clause does not preclude any party from obtaining interim relief on an urgent basis from a court of competent jurisdiction, pending the decision of the arbitrator."]]></textFieldExpression>
			</textField>
		</band>

		<!-- SECTION 8 -->
		<band height="84" splitType="Prevent">
			<staticText>
				<reportElement x="0" y="10" width="24" height="18" uuid="b1a2c3d4-0006-0002-0001-000000000009"/>
				<textElement verticalAlignment="Top">
					<font size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[8.]]></text>
			</staticText>
			<staticText>
				<reportElement x="24" y="10" width="463" height="18" uuid="b1a2c3d4-0006-0003-0001-000000000009"/>
				<textElement verticalAlignment="Top">
					<font size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[General Provisions]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="36" width="487" height="18" uuid="b1a2c3d4-0006-0001-0001-000000000010"/>
				<textElement verticalAlignment="Middle">
					<font size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[Whole Agreement]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="0" y="58" width="487" height="18" uuid="b1a2c3d4-0006-0001-0001-000000000011"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["This Agreement constitutes the whole agreement between the parties and no party is bound by any express or implied term, representation, warranty, promise or the like not recorded in this Agreement"]]></textFieldExpression>
			</textField>
		</band>
		<band height="50" splitType="Prevent">
			<staticText>
				<reportElement x="0" y="4" width="487" height="18" uuid="b1a2c3d4-0007-0001-0001-000000000001"/>
				<textElement verticalAlignment="Middle">
					<font size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[Amendment]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="0" y="24" width="487" height="18" uuid="b1a2c3d4-0007-0001-0001-000000000002"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["No amendment or any consensual cancellation of this Agreement or any part thereof is binding on the parties unless recorded in writing and signed by the parties."]]></textFieldExpression>
			</textField>
		</band>
		<band height="50" splitType="Prevent">
			<staticText>
				<reportElement x="0" y="4" width="487" height="18" uuid="b1a2c3d4-0007-0001-0001-000000000003"/>
				<textElement verticalAlignment="Middle">
					<font size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[Waiver]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="0" y="24" width="487" height="18" uuid="b1a2c3d4-0007-0001-0001-000000000004"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["No relaxation or indulgence which a party may show to another party in any way prejudices or constitutes a waiver of its rights under this Agreement ."]]></textFieldExpression>
			</textField>
		</band>
		<band height="50" splitType="Prevent">
			<staticText>
				<reportElement x="0" y="4" width="487" height="18" uuid="b1a2c3d4-0007-0001-0001-000000000005"/>
				<textElement verticalAlignment="Middle">
					<font size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[Cession and delegation]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
