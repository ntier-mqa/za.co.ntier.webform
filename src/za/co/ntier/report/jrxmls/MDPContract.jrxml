		</band>
		<!-- PAGE 2 -->
		<band height="712" splitType="Stretch">
			<staticText>
				<reportElement x="0" y="15" width="487" height="18" uuid="b1a2c3d4-0002-0001-0001-000000000001"/>
				<textElement verticalAlignment="Middle">
					<font size="10" isBold="true" isUnderline="true"/>
				</textElement>
				<text><![CDATA[WHEREAS]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="55" width="487" height="32" uuid="b1a2c3d4-0002-0001-0001-000000000002"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[The MQA wishes to support the development of employees for the Mining and Minerals Sector in the management field.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="115" width="487" height="18" uuid="b1a2c3d4-0002-0001-0001-000000000003"/>
				<textElement verticalAlignment="Middle">
					<font size="10" isBold="true" isUnderline="true"/>
				</textElement>
				<text><![CDATA[NOW THEREFORE IT IS AGREED AS FOLLOWS:]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="155" width="487" height="18" uuid="b1a2c3d4-0002-0001-0001-000000000004"/>
				<textElement verticalAlignment="Middle">
					<font size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[1.   The Employed Learner]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="185" width="487" height="18" uuid="b1a2c3d4-0002-0001-0001-000000000005"/>
				<textElement verticalAlignment="Middle">
					<font size="10"/>
				</textElement>
				<text><![CDATA[1.1 undertakes:]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="215" width="487" height="30" uuid="b1a2c3d4-0002-0001-0001-000000000006"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[1.1.1. to be placed with an accredited service provider for the purpose of completing the Management Development Programme;]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="250" width="487" height="18" uuid="b1a2c3d4-0002-0001-0001-000000000007"/>
				<textElement verticalAlignment="Middle">
					<font size="10"/>
				</textElement>
				<text><![CDATA[1.1.2. Learners must be Historically Disadvantaged South African (HDSA);]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="272" width="487" height="18" uuid="b1a2c3d4-0002-0001-0001-000000000008"/>
				<textElement verticalAlignment="Middle">
					<font size="10"/>
				</textElement>
				<text><![CDATA[1.1.3. to apply himself / herself diligently and conscientiously to this programme;]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="294" width="487" height="30" uuid="b1a2c3d4-0002-0001-0001-000000000009"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[1.1.4. to observe and comply with all relevant and applicable conditions of training and development of the company;]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="328" width="487" height="18" uuid="b1a2c3d4-0002-0001-0001-000000000010"/>
				<textElement verticalAlignment="Middle">
					<font size="10"/>
				</textElement>
				<text><![CDATA[1.1.5. that he/she is employed at the commencement and for the duration of the training;]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="350" width="487" height="30" uuid="b1a2c3d4-0002-0001-0001-000000000011"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[1.1.6. to attend to all required education commitments for the programme to ensure that they complete the program;]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="384" width="487" height="30" uuid="b1a2c3d4-0002-0001-0001-000000000012"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[1.1.7. to notify the MQA forthwith should he/she at any time cease to be a South African citizen in terms of the South African Citizenship Act, No 88 of 1995;]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="445" width="487" height="18" uuid="b1a2c3d4-0002-0001-0001-000000000013"/>
				<textElement verticalAlignment="Middle">
					<font size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[2.   The MQA undertakes:]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="475" width="487" height="42" uuid="b1a2c3d4-0002-0001-0001-000000000014"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[2.1. to pay the company on behalf of the employed learner the tuition fees which shall not exceed the stipulated amount in the MQA funding policy, the cost of the training material will be at the responsibility of the Employer.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="525" width="487" height="42" uuid="b1a2c3d4-0002-0001-0001-000000000015"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[2.2. notwithstanding 2.1 above, no payments will be made by the MQA on behalf of the employed learner unless the employed learner has returned this Agreement properly signed and completed by the employed learner, his/her guardian where necessary and the company.]]></text>
			</staticText>
		</band>
		<!-- PAGE 3 -->
		<band height="712" splitType="Stretch">
			<staticText>
				<reportElement x="0" y="10" width="487" height="30" uuid="b1a2c3d4-0003-0001-0001-000000000001"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[2.3. To conduct monitoring and evaluation visits in line with MQA Monotoring and Evaluation Policies where the employed learners are being trained academically.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="45" width="487" height="42" uuid="b1a2c3d4-0003-0001-0001-000000000002"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[2.4. The first tranche is paid on signed MoA , signing of the learner contract, certified ID copies, submission of proof of registration, proof of employment and verification of the learner by the MQA Monitoring and Evaluation official]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="93" width="487" height="30" uuid="b1a2c3d4-0003-0001-0001-000000000003"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[2.5. The last tranche will be paid on completion of the Management Development Programme upon submission of the certificate / Statement of results by the company]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="128" width="487" height="42" uuid="b1a2c3d4-0003-0001-0001-000000000004"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[2.6. The payment of any amounts shall be in line with the MQA Funding Policy and where there is any conflict between MQA Funding Policy and this agreement around payment, the MQA Funding Policy will take precedence.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="195" width="487" height="18" uuid="b1a2c3d4-0003-0001-0001-000000000005"/>
				<textElement verticalAlignment="Middle">
					<font size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[3.   The Host Company undertakes:]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="225" width="487" height="30" uuid="b1a2c3d4-0003-0001-0001-000000000006"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[3.1. to implement, apply and strictly adhere to the MQA's Management Development Programme grant criteria and as per the Memorandum of Agreement deliverables;]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="262" width="487" height="30" uuid="b1a2c3d4-0003-0001-0001-000000000007"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[3.2. to provide each individual employed learner with all the tools of trades and consumables for their training and development;]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="298" width="487" height="52" uuid="b1a2c3d4-0003-0001-0001-000000000008"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[3.3. to explain the contents and terms and conditions of this agreement to the employed learner and further give them sufficient time to read through it before signature and upon signature provide the employed learner with a copy and submit the proof of completions for the learner who completed the programme;]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="375" width="487" height="18" uuid="b1a2c3d4-0003-0001-0001-000000000009"/>
				<textElement verticalAlignment="Middle">
					<font size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[4.   Right of Review]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="405" width="487" height="30" uuid="b1a2c3d4-0003-0001-0001-000000000010"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[4.1. The Host employer shall keep full records of all service provided in terms of this Agreement and shall retain such records for the duration of this Agreement .]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="440" width="487" height="65" uuid="b1a2c3d4-0003-0001-0001-000000000011"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[4.2. If the MQA wishes to satisfy itself that the Service Provider is complying with all relevant statutory and regulatory provisions relevant to the provision of the services: or the MoA, as well as policies and procedures determined by the MQA from time to time in respect of the services or specific aspects thereof; the service Provider shall on seven (7) or more written days notice:]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="510" width="487" height="18" uuid="b1a2c3d4-0003-0001-0001-000000000012"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[4.2.1. Participate in a restricted review to be conducted by an independent third party,]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="532" width="487" height="42" uuid="b1a2c3d4-0003-0001-0001-000000000013"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[4.2.2. Provide an independent third part with reasonable information, documentation and access to personnel, premises and records as he may require in order to conduct the restricted review.]]></text>
			</staticText>
		</band>
		<!-- PAGE 4 -->
		<band height="712" splitType="Stretch">
			<staticText>
				<reportElement x="0" y="10" width="487" height="18" uuid="b1a2c3d4-0004-0001-0001-000000000001"/>
				<textElement verticalAlignment="Middle">
					<font size="10"/>
				</textElement>
				<text><![CDATA[4.2.3. The MQA shall bear the costs of the review]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="32" width="487" height="30" uuid="b1a2c3d4-0004-0001-0001-000000000002"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[4.2.4. Should the review indicate the Service Provider is not in compliance with its obligations, the Service Provider will at its own costs, immediately initiate actions to ensure compliance.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="85" width="487" height="18" uuid="b1a2c3d4-0004-0001-0001-000000000003"/>
				<textElement verticalAlignment="Middle">
					<font size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[5.   Domicilium Citandi Et Executandi]]></text>
