					<font size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[5.]]></text>
			</staticText>
			<staticText>
				<reportElement x="24" y="10" width="463" height="18" uuid="b1a2c3d4-0004-0003-0001-000000000003"/>
				<textElement verticalAlignment="Top">
					<font size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[Domicilium Citandi Et Executandi]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="34" width="30" height="18" uuid="b1a2c3d4-0004-0002-0001-000000000004"/>
				<textElement verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<text><![CDATA[5.1.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="30" y="34" width="457" height="18" uuid="b1a2c3d4-0004-0003-0001-000000000004"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["The parties choose as their domicilia citandi et executandi (\"domicilium\") for all purposes under this Agreement, the following addresses -"]]></textFieldExpression>
			</textField>
		</band>

