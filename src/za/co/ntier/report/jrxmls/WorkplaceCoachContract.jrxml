		<!-- PAGE 2 -->
		<band height="712" splitType="Stretch">
			<staticText>
				<reportElement x="0" y="25" width="487" height="18" uuid="75ade12a-b770-42e3-8d7c-8f5168c879b0"/>
				<textElement verticalAlignment="Middle">
					<font size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[WHEREAS]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="48" width="487" height="35" uuid="0ca0d6a6-267c-4fb5-bc72-95d8fb0a99db"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[The MQA wishes to support the development of employees in the Mining and Minerals Sector by funding the coaches within companies for the purpose of transferring skills to learner within the workplace.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="92" width="487" height="18" uuid="d4376f77-bb6a-40e1-9298-1f92f296645e"/>
				<textElement verticalAlignment="Middle">
					<font size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[NOW THEREFORE IT IS AGREED AS FOLLOWS:]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="118" width="487" height="18" uuid="92a7f49b-0634-480c-90e2-c12751b2987a"/>
				<textElement verticalAlignment="Middle">
					<font size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[1.  The Coach]]></text>
			</staticText>
			<staticText>
				<reportElement x="18" y="138" width="469" height="16" uuid="9c86f0c3-2c40-434f-8226-f307ea9e27cd"/>
				<textElement verticalAlignment="Middle">
					<font size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[1.1 undertakes:]]></text>
			</staticText>
			<staticText>
				<reportElement x="45" y="158" width="45" height="18" uuid="e694ad83-ea10-4a7e-be26-2146ec101db5"/>
				<textElement verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[1.1.1]]></text>
			</staticText>
			<staticText>
				<reportElement x="90" y="158" width="397" height="18" uuid="580e856e-8af0-486f-bb0d-aa79e91bfb81"/>
				<textElement verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[transfer skills and knowledge to learners;]]></text>
			</staticText>
			<staticText>
				<reportElement x="45" y="178" width="45" height="18" uuid="35368076-bdc1-42e7-94bc-f76ec0cbd80c"/>
				<textElement verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[1.1.2]]></text>
			</staticText>
			<staticText>
				<reportElement x="90" y="178" width="397" height="18" uuid="2ff91556-0143-4801-a9a8-1e5580aa5498"/>
				<textElement verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[to apply himself / herself diligently and conscientiously to this programme;]]></text>
			</staticText>
			<staticText>
				<reportElement x="45" y="198" width="45" height="18" uuid="94d3588d-a107-482c-8883-79b26695c167"/>
				<textElement verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[1.1.3]]></text>
			</staticText>
			<staticText>
				<reportElement x="90" y="198" width="397" height="28" uuid="40557389-fac8-4065-b178-c4d42adab60e"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[to observe and comply with all relevant and applicable conditions of employement and training of the company;]]></text>
			</staticText>
			<staticText>
				<reportElement x="45" y="228" width="45" height="18" uuid="e81cec46-95db-4a6e-bf3a-666f2956ad4a"/>
				<textElement verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[1.1.4]]></text>
			</staticText>
			<staticText>
				<reportElement x="90" y="228" width="397" height="28" uuid="4597ba78-898d-4107-9bbc-be80f2bd17f7"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[to notify the MQA forthwith should he/she at any time cease to be a South African citizen in terms of the South African Citizenship Act, No 88 of 1995;]]></text>
			</staticText>
			<staticText>
				<reportElement x="45" y="258" width="45" height="18" uuid="b4167684-beeb-47b9-ad85-a28dbc6cdac8"/>
				<textElement verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[1.1.5]]></text>
			</staticText>
			<staticText>
				<reportElement x="90" y="258" width="397" height="28" uuid="83726933-8e3b-4113-950f-ad10326a265f"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[to undergo from time to time whatever medical examinations that may be required of him/her by the company;]]></text>
			</staticText>
			<staticText>
				<reportElement x="18" y="294" width="469" height="18" uuid="25d937e5-3661-42d8-84ed-ea8852176b78"/>
				<textElement verticalAlignment="Middle">
					<font size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[1.2 The MQA undertakes:]]></text>
			</staticText>
			<staticText>
				<reportElement x="45" y="314" width="45" height="18" uuid="ccba006c-761c-4f97-8d6e-141d82b5b220"/>
				<textElement verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[1.2.1]]></text>
			</staticText>
			<staticText>
				<reportElement x="90" y="314" width="397" height="28" uuid="fca20ca5-5c57-449c-84d8-342e3ced7995"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[To Pay the company on behalf of the Coach an amount as determined by the MQA in its sole discretion which shall not exceed a stipulated amount;]]></text>
			</staticText>
			<staticText>
				<reportElement x="90" y="344" width="397" height="38" uuid="ce199fa7-1fbc-4b95-8030-7662c23b6b4c"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[Notwithstanding 1.2.1 above, no payments will be made by the MQA on behalf of the Coach unless the Coach has returned this Agreement properly signed and completed by the Coach ;]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="390" width="487" height="18" uuid="cd8ca22c-590f-4e0c-ae16-4158834d82b8"/>
				<textElement verticalAlignment="Middle">
					<font size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[2.  The Host Company undertakes:]]></text>
			</staticText>
			<staticText>
				<reportElement x="18" y="414" width="35" height="18" uuid="5feb2b9a-9a0d-489b-8c6c-af93444741a7"/>
				<textElement verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[2.1]]></text>
			</staticText>
			<staticText>
				<reportElement x="53" y="414" width="434" height="28" uuid="91bea7d4-fe1f-4afe-8e09-eb228d07174d"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[To implement, apply and strictly adhere to the MQA's Workplace Coaches Programme as per the Memorandum of Agreement deliverables;]]></text>
			</staticText>
			<staticText>
				<reportElement x="18" y="444" width="35" height="18" uuid="4cb6915c-a9a0-417f-ab66-99169f904217"/>
				<textElement verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[2.2]]></text>
			</staticText>
			<staticText>
				<reportElement x="53" y="444" width="434" height="28" uuid="e35bf32a-7c58-438f-92d0-030728956949"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[to recruit, suitably qualified coaches who will train mentor, coach, conduct assessment and compile progress reports for the learners;]]></text>
			</staticText>
			<staticText>
				<reportElement x="18" y="474" width="35" height="18" uuid="70d2a68e-68e6-46c4-8988-dbd949f0d307"/>
				<textElement verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[2.3]]></text>
			</staticText>
			<staticText>
				<reportElement x="53" y="474" width="434" height="28" uuid="b9a2d7f4-fb70-4c42-a170-808e198662bd"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[to provide each individual Coach with all the tools of trades and consumables for their training and development;]]></text>
			</staticText>
			<staticText>
				<reportElement x="18" y="504" width="35" height="18" uuid="32192af7-719e-4498-8951-ff6e5deec150"/>
				<textElement verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[2.4]]></text>
			</staticText>
			<staticText>
				<reportElement x="53" y="504" width="434" height="38" uuid="21642af9-568d-42f5-8f37-aa0b1a55bb52"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[to explain the contents and terms and conditions of this agreement to the Coach and furher give them sufficient time to read through it before signature and upon signature provide the Coach with a copy;]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="550" width="487" height="18" uuid="cd5c6709-3e1a-4c6e-9d10-4bc1ea3e4d2c"/>
				<textElement verticalAlignment="Middle">
					<font size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[3.  Financial Obligations]]></text>
			</staticText>
			<staticText>
				<reportElement x="18" y="575" width="469" height="18" uuid="95fafcd4-53d3-48a7-a713-c1a317c28805"/>
				<textElement verticalAlignment="Middle">
					<font size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[3.1 The MQA's Financial Obligations]]></text>
			</staticText>
		</band>

		<!-- PAGE 3 -->
		<band height="712" splitType="Stretch">
			<textField isBlankWhenNull="true">
				<reportElement x="45" y="25" width="442" height="25" uuid="02a96d46-4f9b-4242-8602-1fb6ac6b7db4"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<textFieldExpression><![CDATA["The MQA undertakes to pay to the Host Company the amount not exceeding " + ($P{ContractData} != null && $P{ContractData}.get("GrantAmount") != null ? (String)$P{ContractData}.get("GrantAmount") : ($P{GrantAmount} != null && !$P{GrantAmount}.isBlank() ? $P{GrantAmount} : "R240 000")) + " per annum."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="55" width="487" height="18" uuid="765593ca-3a56-46f1-b0d8-b021b0361cd3"/>
				<textElement verticalAlignment="Middle">
					<font size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[The Host Company's financial obligations]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="80" width="487" height="18" uuid="9fa17ff2-1ce7-4187-9dbe-082cc88e3637"/>
				<textElement verticalAlignment="Middle">
					<font size="10"/>
				</textElement>
				<text><![CDATA[The Host Company undertakes -]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="102" width="487" height="18" uuid="2180988f-049a-47e1-adb6-4fd05c0a2261"/>
				<textElement verticalAlignment="Middle">
					<font size="10"/>
				</textElement>
				<text><![CDATA[To pay a monthly allowance to the Coach as follows:]]></text>
			</staticText>
			<staticText>
				<reportElement x="18" y="125" width="45" height="18" uuid="d02ac2e3-6af1-424a-a07c-6aaed441ae33"/>
				<textElement verticalAlignment="Top">
					<font size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[3.1.1]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="63" y="125" width="424" height="30" uuid="d72879ce-f6fd-4be1-a0d9-5f8386d5be95"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<textFieldExpression><![CDATA["At least " + ($P{ContractData} != null && $P{ContractData}.get("MonthlyAllowance") != null ? (String)$P{ContractData}.get("MonthlyAllowance") : ($P{MonthlyAllowance} != null && !$P{MonthlyAllowance}.isBlank() ? $P{MonthlyAllowance} : "R18 000")) + " per month, to be paid to the coach as allowance for the duration of " + ($P{ContractData} != null && $P{ContractData}.get("DurationMonths") != null ? (String)$P{ContractData}.get("DurationMonths") : ($P{DurationMonths} != null && !$P{DurationMonths}.isBlank() ? $P{DurationMonths} : "12")) + " months;"]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="18" y="160" width="45" height="18" uuid="21c96b69-1821-43bf-8806-18fdc42d7506"/>
				<textElement verticalAlignment="Top">
					<font size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[3.1.2]]></text>
			</staticText>
			<staticText>
				<reportElement x="63" y="160" width="424" height="32" uuid="22f8e9b1-1b25-45cd-a2b2-e1773198c148"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[To provider the coach will all necessary tools of trade and personal protective equipment for his or her training and development of the learners;]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="200" width="487" height="18" uuid="3233248f-6b02-4b4f-bffc-39bbc8cab712"/>
				<textElement verticalAlignment="Middle">
					<font size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[4.  The MQA shall be entitled to terminate the placement forthwith]]></text>
			</staticText>
			<staticText>
				<reportElement x="18" y="222" width="469" height="18" uuid="eaf50ca4-876b-48a3-9d76-df3bc90b9d6d"/>
				<textElement verticalAlignment="Middle">
					<font size="10"/>
				</textElement>
				<text><![CDATA[4.1 if the Coach:]]></text>
			</staticText>
			<staticText>
				<reportElement x="45" y="242" width="45" height="18" uuid="2d63fb32-d12f-42a6-9c7e-a523ff85f2f5"/>
				<textElement verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[4.1.1]]></text>
			</staticText>
			<staticText>
				<reportElement x="90" y="242" width="397" height="28" uuid="ee48b1e2-961e-4c8f-884d-4a013cab49bf"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[either ceases to pursue or fails to meet the minimum performance requirements of the programme referred to in 1.1.1;]]></text>
			</staticText>
			<staticText>
				<reportElement x="45" y="274" width="45" height="18" uuid="0426aaf1-28a1-4826-a736-b72bf9ffdb7a"/>
				<textElement verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[4.1.2]]></text>
			</staticText>
			<staticText>
				<reportElement x="90" y="274" width="397" height="18" uuid="4053a3e5-2898-40ac-966f-f5297cf30eab"/>
				<textElement verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[ceases to be a South African citizen in terms of 1.1.11;]]></text>
			</staticText>
			<staticText>
				<reportElement x="45" y="296" width="45" height="18" uuid="45bd189d-9b83-4d1f-8b74-e0819e7a5664"/>
				<textElement verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[4.1.3]]></text>
			</staticText>
			<staticText>
				<reportElement x="90" y="296" width="397" height="18" uuid="5977a559-f8f6-432f-a9ae-90f4bb37fbe6"/>
				<textElement verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[is convicted of a criminal offence; and]]></text>
			</staticText>
			<staticText>
				<reportElement x="18" y="320" width="469" height="25" uuid="3f5fa9b0-d4e9-488c-8bee-7190c92b15c7"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[4.2 the MQA is not satisfied with any report from the company on the Coach's progress and conduct;]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="352" width="487" height="18" uuid="ed9ed7f7-6e73-4bac-9f93-4c4baaa00d90"/>
				<textElement verticalAlignment="Middle">
					<font size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[5.  Whole Agreement]]></text>
			</staticText>
			<staticText>
				<reportElement x="18" y="374" width="469" height="58" uuid="295d2722-bf51-4570-adfc-a65fadabbde9"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[5.1 This Agreement constitutes the entire agreement between the parties and supersedes all prior representations, negotiationsm, memoranda and agreements. No modification or alteration of this Agreement shall be of any force or effect unless reduced to writing and signed by the three parties;]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="440" width="487" height="18" uuid="d31a9e2c-53c7-4aea-aef2-d69d0b881e58"/>
				<textElement verticalAlignment="Middle">
					<font size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[6.  Domicilium Citandi Et Executandi]]></text>
			</staticText>
			<staticText>
				<reportElement x="18" y="462" width="469" height="32" uuid="33e5ee2f-d505-42bc-be96-518c94a673a3"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[6.1 The parties choose as their domicilia citandi et executandi ("domicilium") for all purposes under this Agreement, the following addresses -]]></text>
			</staticText>
			<staticText>
				<reportElement x="35" y="502" width="452" height="18" uuid="0dda93e8-89bd-4fd6-a15f-9c2f465dacd4"/>
				<textElement verticalAlignment="Middle">
					<font size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[MQA]]></text>
			</staticText>
			<staticText>
				<reportElement x="55" y="524" width="115" height="18" uuid="4dab0d09-efe6-4bfb-aeb6-623e0e4347f3"/>
				<textElement verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[Physical Address:]]></text>
