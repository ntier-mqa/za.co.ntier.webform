			</frame>

			<!-- Host Company Contact Details Frame -->
			<frame>
				<reportElement positionType="Float" x="35" y="200" width="452" height="18" uuid="92f97b66-7f62-40b6-b7e1-6ec30cef871f"/>
				<staticText>
					<reportElement x="20" y="0" width="115" height="18" uuid="b178b66b-2c73-40ce-8d0c-0b47fba78411"/>
					<textElement verticalAlignment="Middle">
						<font size="10"/>
					</textElement>
					<text><![CDATA[Contact Details:]]></text>
				</staticText>
				<textField isBlankWhenNull="true">
					<reportElement x="135" y="0" width="317" height="18" uuid="95f188fa-2167-4515-b6b7-1d8aa06a4c3a"/>
					<textElement verticalAlignment="Middle">
						<font size="10"/>
					</textElement>
					<textFieldExpression><![CDATA[$P{ContractData} != null && $P{ContractData}.get("EmployerContact") != null ? (String)$P{ContractData}.get("EmployerContact") : ($P{EmployerContact} != null && !$P{EmployerContact}.isBlank() ? $P{EmployerContact} : ($P{ContractData} != null && $P{ContractData}.get("CompanyContact") != null ? (String)$P{ContractData}.get("CompanyContact") : ""))]]></textFieldExpression>
				</textField>
			</frame>

			<!-- 6.2 -->
			<staticText>
				<reportElement positionType="Float" x="0" y="226" width="487" height="28" uuid="f5167320-795f-4966-bcdc-c01b1be8a9e9"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[6.2 Any notice or communication required or permitted to be given in terms of this Agreement is valid and effective only if in writing and delivered by pre-paid registered post, hand, telefax or e-mail;]]></text>
			</staticText>

			<!-- 6.3 -->
			<staticText>
				<reportElement positionType="Float" x="0" y="258" width="487" height="30" uuid="8f15ac6e-736b-45e6-acc9-1152623609fc"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[6.3 Any party may by notice to the other parties change its domicillium, provided that the change is effective vis-à-vis that addressee only 10 business days after receipt of the notice by the addressee;]]></text>
			</staticText>

			<!-- 6.4 -->
			<staticText>
				<reportElement positionType="Float" x="0" y="292" width="487" height="18" uuid="95334809-da4a-467a-92ce-ae418ff463c4"/>
				<textElement verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[6.4 Any notice to a party -]]></text>
			</staticText>

			<staticText>
				<reportElement positionType="Float" x="18" y="312" width="35" height="18" uuid="995354f5-a2d2-4180-8b4f-e591bafd2e6d"/>
				<textElement verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[6.4.1]]></text>
			</staticText>
			<staticText>
				<reportElement positionType="Float" x="53" y="312" width="434" height="30" uuid="36c8a7ce-353d-4613-91a1-6f8c52a70c3d"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[sent by pre-paid registered post to the stipulated physical address is deemed to have been received 10 business after posting (unless the contraty is proved);]]></text>
			</staticText>

			<staticText>
				<reportElement positionType="Float" x="18" y="346" width="35" height="18" uuid="cc6ccd07-b592-47bf-aac9-eebb632b5c73"/>
				<textElement verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[6.4.2]]></text>
			</staticText>
			<staticText>
				<reportElement positionType="Float" x="53" y="346" width="434" height="30" uuid="b1bf8f32-d80a-4e09-9382-7b4427045541"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[delivered by hand to a responsible person at the stipulated physical address during ordinary business hours is deemed to have been received on the day of delivery;]]></text>
			</staticText>

			<staticText>
				<reportElement positionType="Float" x="18" y="380" width="35" height="18" uuid="52f3e385-a638-4871-8a68-ed905ab4c400"/>
				<textElement verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[6.4.3]]></text>
			</staticText>
			<staticText>
				<reportElement positionType="Float" x="53" y="380" width="434" height="30" uuid="6fd5f7de-3b2b-4ef3-a3da-13cf40b10dd1"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[sent by telefax to the stipulated telefax number is deemed to have been received on the date of dispatch (unless the contrary is proved); or]]></text>
			</staticText>

			<staticText>
				<reportElement positionType="Float" x="18" y="414" width="35" height="18" uuid="7b86efba-9c11-4044-97ba-c43af902534c"/>
				<textElement verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[6.4.4]]></text>
			</staticText>
			<staticText>
				<reportElement positionType="Float" x="53" y="414" width="434" height="30" uuid="632f67ce-1309-41cc-957f-6db25fce735b"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[sent by e-mail to the stipulated e-mail address is deemed to have been received on the date of dispatch (unless the contrary is proved);]]></text>
			</staticText>

			<staticText>
				<reportElement positionType="Float" x="18" y="448" width="35" height="18" uuid="5889d340-db1c-4c8f-b0a6-85ebcd715963"/>
				<textElement verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[6.4.5]]></text>
			</staticText>
			<staticText>
				<reportElement positionType="Float" x="53" y="448" width="434" height="42" uuid="dd30dba6-4a96-4725-b8dc-a9a52efd5773"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[Despite this claise, a written notice or communication actually received by a party is adequate written notice or communication to it notwithstanding that it was not sent to or delivered at its stipulated domicillim;]]></text>
			</staticText>

			<!-- 7. Breach And Termination -->
			<staticText>
				<reportElement positionType="Float" x="0" y="496" width="487" height="18" uuid="5653a2e9-f63b-4c33-ba06-63a2cda31c4f"/>
				<textElement verticalAlignment="Middle">
					<font size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[7.  Breach And Termination]]></text>
			</staticText>
			<staticText>
				<reportElement positionType="Float" x="18" y="516" width="469" height="72" uuid="81a3a18a-13c0-4c5b-b541-423220983359"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[7.1 If any of the parties breach or otherwise default on any of its obligations under this Agreement, or remain in default or fail to remedy such breach within 10 business days of receipt of a written notice calling upon it to do so, the other party is entitled, an addition to any other rights it may have, or remedies which may be available, to cancel this agreement forthwith, or to obtain an order for specific performance, or to claim damages together with any amounts owing under this Agreement.]]></text>
			</staticText>
			<staticText>
				<reportElement positionType="Float" x="18" y="592" width="469" height="24" uuid="5740b68a-6827-4e2a-9402-b1edc35f769d"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[7.2 In addition to any other legal remedies the parties may have, this Agreement may be terminated with immediate]]></text>
			</staticText>
		</band>

<!-- PAGE 5 -->
		<band height="712" splitType="Stretch">
			<staticText>
				<reportElement x="18" y="10" width="469" height="26" uuid="08cbb05e-b9fc-46aa-a146-0aed3e2a4357"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[effect if a party commits a material breach of the Agreement. The following will amongst other constitute matrial breach of this Agreement -]]></text>
			</staticText>
			<staticText>
				<reportElement x="45" y="40" width="45" height="18" uuid="069c9e10-7341-4d6f-8626-30e98fb6ad48"/>
				<textElement verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[7.2.1]]></text>
			</staticText>
			<staticText>
				<reportElement x="90" y="40" width="397" height="18" uuid="0c69a61b-548a-499a-8883-dfc8e2a9f589"/>
				<textElement verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[failure to comply with a party's obligations in terms of this agreement;]]></text>
			</staticText>
			<staticText>
				<reportElement x="45" y="60" width="45" height="18" uuid="b981a790-1cd5-414d-b100-451196d63c63"/>
				<textElement verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[7.2.2]]></text>
			</staticText>
			<staticText>
				<reportElement x="90" y="60" width="397" height="32" uuid="718d6217-a23e-44d4-a108-de9b608823bf"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[the Host Company is placed under the provisional or final liquidation, whether voluntary or compulsory, or is placed under judicial management;]]></text>
			</staticText>
			<staticText>
				<reportElement x="45" y="94" width="45" height="18" uuid="c7221744-bed8-4ed6-8530-e2fc2fe66fcb"/>
				<textElement verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[7.2.3]]></text>
			</staticText>
			<staticText>
				<reportElement x="90" y="94" width="397" height="18" uuid="322140f6-c812-4679-9ec4-62f1415b950b"/>
				<textElement verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[failure to adhere to agreed time frames; or]]></text>
			</staticText>
			<staticText>
				<reportElement x="45" y="114" width="45" height="18" uuid="2c1423d6-69a6-465b-abb5-8dea523c3dd2"/>
				<textElement verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[7.2.4]]></text>
			</staticText>
			<staticText>
				<reportElement x="90" y="114" width="397" height="24" uuid="3c4a379e-e08e-4f44-916e-02fb7ecf0264"/>
				<textElement verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[use of the MQA grant funding for any purpose except for the purpose provided;]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="144" width="487" height="18" uuid="1705695e-901a-4fc5-b0d7-711b2f778b2c"/>
				<textElement verticalAlignment="Middle">
					<font size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[8.  Dispute Resolution]]></text>
			</staticText>
			<staticText>
				<reportElement x="18" y="164" width="469" height="42" uuid="4f3f7c94-5dc4-43a7-8515-d2f027214a00"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[8.1 Any dispute that arises between any of the parties in connection with the interpretation, application or termination of this Agreement must, unless resolved between the parties as contemplated below, be determined by arbitration in terms of this clause.]]></text>
			</staticText>
			<staticText>
				<reportElement x="18" y="210" width="469" height="52" uuid="f27284df-1c7a-48d6-99bf-6d43edb26461"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[8.2 Any party to the dispute may deliver a notice of dispute to the other parties for consideration by a committee consisting of nominated representatives of the parties in dispute, which must convene and use its best endeavours to resolve the dispute within 10 business days of delivery of the notice.]]></text>
			</staticText>
			<staticText>
				<reportElement x="18" y="266" width="469" height="68" uuid="444cd08e-fa4e-405e-9b97-f52b48cf3422"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[8.3 If the committee is unable to meet or to resolve the dispute within that period, any party to the dispute may by written notice to the other parties, setting out the particulars of the dispute, refer the dispute for arbitration under the auspices of the Arbitration Foundation of South Africa ("AFSA"), each party to pay its own costs and the costs of the arbitrator to be shared by the parties to the dispute.]]></text>
			</staticText>
			<staticText>
				<reportElement x="18" y="338" width="469" height="68" uuid="19ab082b-5ba5-4739-ae87-25aa23169109"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[8.4 The arbitration must be held in Gauteng in accordance with the formalities and procedures determined by the arbitrator and, subject to exceptional circumstances, must be concluded within 20 business days of the arbitrator's appointment. Any decision (including an award) made by the arbitrator is final and binding on the parties and may be made an order of any court of competent jurisdiction.]]></text>
			</staticText>
			<staticText>
				<reportElement x="18" y="410" width="469" height="36" uuid="6d080939-dfb8-4415-a4f8-9ee9b3f51459"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[8.5 This clause does not preclude any party from obtaining interim relief on an urgent basis from a court of competent jurisdiction, pending the decision of the arbitrator.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="450" width="487" height="18" uuid="e3c28d30-b50e-46c0-8723-eca9db16d5c1"/>
				<textElement verticalAlignment="Middle">
					<font size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[9.  General Provisions]]></text>
			</staticText>
			<staticText>
				<reportElement x="18" y="470" width="469" height="16" uuid="21407c7e-44c5-439b-b1b7-9c21423b25b7"/>
				<textElement verticalAlignment="Middle">
					<font size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[Whole Agreement]]></text>
			</staticText>
			<staticText>
				<reportElement x="35" y="488" width="452" height="44" uuid="664ebe33-4fe2-425c-b67c-bc24b04e56f8"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[This Agreement constitutes the whole agreement between the parties and no party is bound by any express or implied term, representation, warranty, promise or the like not recorded in this Agreement.]]></text>
			</staticText>
			<staticText>
				<reportElement x="18" y="536" width="469" height="16" uuid="362ba045-24df-4e10-969d-3404414b73c5"/>
				<textElement verticalAlignment="Middle">
					<font size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[Amendment]]></text>
			</staticText>
			<staticText>
				<reportElement x="35" y="554" width="452" height="34" uuid="c086c373-a5e4-4dec-bd40-ef2f2789e446"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[No amendment or any consensual cancellation of this Agreement or any part thereof is binding on the parties unless recorded in writing and signed by the parties.]]></text>
			</staticText>
			<staticText>
				<reportElement x="18" y="592" width="469" height="16" uuid="e8adbb51-df9b-4328-8b91-b9d734b67908"/>
				<textElement verticalAlignment="Middle">
					<font size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[Waiver]]></text>
			</staticText>
			<staticText>
				<reportElement x="35" y="610" width="452" height="34" uuid="2607a6b7-81f7-4d2c-a4ac-e9fc1c113db7"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[No relaxation or indulgence which a party may show to another party in any way prejudices or constitutes a waiver of its rights under this Agreement.]]></text>
			</staticText>
		</band>

		<!-- PAGE 6 -->
		<band height="712" splitType="Stretch">
			<staticText>
				<reportElement x="18" y="20" width="469" height="18" uuid="648c57d5-07f7-4e00-bf6c-16de865fbacd"/>
				<textElement verticalAlignment="Middle">
					<font size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[Cession and delegation]]></text>
			</staticText>
			<staticText>
				<reportElement x="35" y="40" width="452" height="35" uuid="1738ba37-083a-4164-998a-706b03d0668e"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[No party may cede, assign or otherwise encumber any of its rights or delegate any of its obligations under this Agreement without the prior written consent of the other parties.]]></text>
			</staticText>
			<staticText>
				<reportElement x="18" y="80" width="469" height="18" uuid="a4138e26-a7cb-49e2-b7f6-fe5c13e7c5b7"/>
				<textElement verticalAlignment="Middle">
					<font size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[Severability]]></text>
			</staticText>
			<staticText>
				<reportElement x="35" y="100" width="452" height="35" uuid="cfe386f6-02e5-448e-8680-5a9dfa507e30"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[If any of the provisions of this Agreement are found to be invalid, unlawful or unenforceable, these terms will be severable from the remaining terms, which continue to be valid and enforceable.]]></text>
			</staticText>
			<staticText>
				<reportElement x="18" y="140" width="469" height="18" uuid="31859411-11c4-4669-8bfb-5fbeab7d81c4"/>
				<textElement verticalAlignment="Middle">
					<font size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[Governing law and courts]]></text>
			</staticText>
			<staticText>
				<reportElement x="35" y="160" width="452" height="20" uuid="5e7db229-e0a4-41c9-92c5-25876a120cac"/>
				<textElement verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[This Agreement will in all respects be governed by South African law.]]></text>
			</staticText>
			<staticText>
				<reportElement x="18" y="185" width="469" height="18" uuid="ab3ff0a8-c4dd-4eb3-825d-8de9c78d057f"/>
				<textElement verticalAlignment="Middle">
					<font size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[Execution of the Agreement]]></text>
			</staticText>
			<staticText>
				<reportElement x="35" y="205" width="452" height="35" uuid="2dca8081-13ef-48ee-a939-582e4974b305"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[This Agreement may be executed in one or more counterparts and in separate counterparts, each of which when executed is deemed to be an original but when taken together constitute one and the same Agreement.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="250" width="487" height="18" uuid="ac9c0580-6105-4af7-b9f7-735e673c7aca"/>
				<textElement verticalAlignment="Middle">
					<font size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[SIGNATURES]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="278" width="487" height="18" uuid="18fd3cc1-7b65-4f67-98d4-8c6f78af7c80"/>
				<textElement verticalAlignment="Middle">
					<font size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[COMPANY SIGNATURE]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="300" width="487" height="18" uuid="4df461cb-c4c9-427f-9475-87447c7c6725"/>
				<textElement verticalAlignment="Middle">
					<font size="9.5"/>
				</textElement>
				<text><![CDATA[Signed at ............................................. on this .................... day of ................................ 20......]]></text>
			</staticText>
