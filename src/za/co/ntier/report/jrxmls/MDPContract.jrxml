		<band height="26" splitType="Prevent">
			<staticText>
				<reportElement x="18" y="0" width="38" height="18" uuid="b1a2c3d4-0002-0002-0001-000000000006"/>
				<textElement verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<text><![CDATA[1.1.1.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="56" y="0" width="431" height="18" uuid="b1a2c3d4-0002-0003-0001-000000000006"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["to be placed with an accredited service provider for the purpose of completing the Management Development Programme;"]]></textFieldExpression>
			</textField>
		</band>
		<band height="26" splitType="Prevent">
			<staticText>
				<reportElement x="18" y="0" width="38" height="18" uuid="b1a2c3d4-0002-0002-0001-000000000007"/>
				<textElement verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<text><![CDATA[1.1.2.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="56" y="0" width="431" height="18" uuid="b1a2c3d4-0002-0003-0001-000000000007"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["Learners must be Historically Disadvantaged South African (HDSA);"]]></textFieldExpression>
			</textField>
		</band>
		<band height="26" splitType="Prevent">
			<staticText>
				<reportElement x="18" y="0" width="38" height="18" uuid="b1a2c3d4-0002-0002-0001-000000000008"/>
				<textElement verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<text><![CDATA[1.1.3.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="56" y="0" width="431" height="18" uuid="b1a2c3d4-0002-0003-0001-000000000008"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["to apply himself / herself diligently and conscientiously to this programme;"]]></textFieldExpression>
			</textField>
		</band>
		<band height="26" splitType="Prevent">
			<staticText>
				<reportElement x="18" y="0" width="38" height="18" uuid="b1a2c3d4-0002-0002-0001-000000000009"/>
				<textElement verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<text><![CDATA[1.1.4.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="56" y="0" width="431" height="18" uuid="b1a2c3d4-0002-0003-0001-000000000009"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["to observe and comply with all relevant and applicable conditions of training and development of the company;"]]></textFieldExpression>
			</textField>
		</band>
		<band height="26" splitType="Prevent">
			<staticText>
				<reportElement x="18" y="0" width="38" height="18" uuid="b1a2c3d4-0002-0002-0001-000000000010"/>
				<textElement verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<text><![CDATA[1.1.5.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="56" y="0" width="431" height="18" uuid="b1a2c3d4-0002-0003-0001-000000000010"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["that he/she is employed at the commencement and for the duration of the training;"]]></textFieldExpression>
			</textField>
		</band>
		<band height="26" splitType="Prevent">
			<staticText>
				<reportElement x="18" y="0" width="38" height="18" uuid="b1a2c3d4-0002-0002-0001-000000000011"/>
				<textElement verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<text><![CDATA[1.1.6.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="56" y="0" width="431" height="18" uuid="b1a2c3d4-0002-0003-0001-000000000011"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["to attend to all required education commitments for the programme to ensure that they complete the program;"]]></textFieldExpression>
			</textField>
		</band>
		<band height="26" splitType="Prevent">
			<staticText>
				<reportElement x="18" y="0" width="38" height="18" uuid="b1a2c3d4-0002-0002-0001-000000000012"/>
				<textElement verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<text><![CDATA[1.1.7.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="56" y="0" width="431" height="18" uuid="b1a2c3d4-0002-0003-0001-000000000012"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["to notify the MQA forthwith should he/she at any time cease to be a South African citizen in terms of the South African Citizenship Act, No 88 of 1995;"]]></textFieldExpression>
			</textField>
		</band>

		<!-- SECTION 2 -->
		<band height="60" splitType="Prevent">
			<staticText>
				<reportElement x="0" y="10" width="24" height="18" uuid="b1a2c3d4-0002-0002-0001-000000000013"/>
				<textElement verticalAlignment="Top">
					<font size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[2.]]></text>
			</staticText>
			<staticText>
				<reportElement x="24" y="10" width="463" height="18" uuid="b1a2c3d4-0002-0003-0001-000000000013"/>
				<textElement verticalAlignment="Top">
					<font size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[The MQA undertakes:]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="34" width="30" height="18" uuid="b1a2c3d4-0002-0002-0001-000000000014"/>
				<textElement verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<text><![CDATA[2.1.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="30" y="34" width="457" height="18" uuid="b1a2c3d4-0002-0003-0001-000000000014"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["to pay the company on behalf of the employed learner the tuition fees which shall not exceed the stipulated amount in the MQA funding policy, the cost of the training material will be at the responsibility of the Employer."]]></textFieldExpression>
			</textField>
		</band>
		<band height="26" splitType="Prevent">
			<staticText>
				<reportElement x="0" y="0" width="30" height="18" uuid="b1a2c3d4-0002-0002-0001-000000000015"/>
				<textElement verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<text><![CDATA[2.2.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="30" y="0" width="457" height="18" uuid="b1a2c3d4-0002-0003-0001-000000000015"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["notwithstanding 2.1 above, no payments will be made by the MQA on behalf of the employed learner unless the employed learner has returned this Agreement properly signed and completed by the employed learner, his/her guardian where necessary and the company."]]></textFieldExpression>
			</textField>
		</band>
		<band height="26" splitType="Prevent">
			<staticText>
				<reportElement x="0" y="0" width="30" height="18" uuid="b1a2c3d4-0003-0002-0001-000000000001"/>
				<textElement verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<text><![CDATA[2.3.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="30" y="0" width="457" height="18" uuid="b1a2c3d4-0003-0003-0001-000000000001"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["To conduct monitoring and evaluation visits in line with MQA Monotoring and Evaluation Policies where the employed learners are being trained academically."]]></textFieldExpression>
			</textField>
		</band>
		<band height="26" splitType="Prevent">
			<staticText>
				<reportElement x="0" y="0" width="30" height="18" uuid="b1a2c3d4-0003-0002-0001-000000000002"/>
				<textElement verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<text><![CDATA[2.4.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="30" y="0" width="457" height="18" uuid="b1a2c3d4-0003-0003-0001-000000000002"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["The first tranche is paid on signed MoA , signing of the learner contract, certified ID copies, submission of proof of registration, proof of employment and verification of the learner by the MQA Monitoring and Evaluation official"]]></textFieldExpression>
			</textField>
		</band>
		<band height="26" splitType="Prevent">
			<staticText>
				<reportElement x="0" y="0" width="30" height="18" uuid="b1a2c3d4-0003-0002-0001-000000000003"/>
				<textElement verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<text><![CDATA[2.5.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="30" y="0" width="457" height="18" uuid="b1a2c3d4-0003-0003-0001-000000000003"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["The last tranche will be paid on completion of the Management Development Programme upon submission of the certificate / Statement of results by the company"]]></textFieldExpression>
			</textField>
		</band>
		<band height="26" splitType="Prevent">
			<staticText>
				<reportElement x="0" y="0" width="30" height="18" uuid="b1a2c3d4-0003-0002-0001-000000000004"/>
				<textElement verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<text><![CDATA[2.6.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="30" y="0" width="457" height="18" uuid="b1a2c3d4-0003-0003-0001-000000000004"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["The payment of any amounts shall be in line with the MQA Funding Policy and where there is any conflict between MQA Funding Policy and this agreement around payment, the MQA Funding Policy will take precedence."]]></textFieldExpression>
			</textField>
		</band>

		<!-- SECTION 3 -->
		<band height="60" splitType="Prevent">
			<staticText>
				<reportElement x="0" y="10" width="24" height="18" uuid="b1a2c3d4-0003-0002-0001-000000000005"/>
				<textElement verticalAlignment="Top">
					<font size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[3.]]></text>
			</staticText>
			<staticText>
				<reportElement x="24" y="10" width="463" height="18" uuid="b1a2c3d4-0003-0003-0001-000000000005"/>
				<textElement verticalAlignment="Top">
					<font size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[The Host Company undertakes:]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="34" width="30" height="18" uuid="b1a2c3d4-0003-0002-0001-000000000006"/>
				<textElement verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<text><![CDATA[3.1.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="30" y="34" width="457" height="18" uuid="b1a2c3d4-0003-0003-0001-000000000006"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["to implement, apply and strictly adhere to the MQA's Management Development Programme grant criteria and as per the Memorandum of Agreement deliverables;"]]></textFieldExpression>
			</textField>
		</band>
		<band height="26" splitType="Prevent">
			<staticText>
				<reportElement x="0" y="0" width="30" height="18" uuid="b1a2c3d4-0003-0002-0001-000000000007"/>
				<textElement verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<text><![CDATA[3.2.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="30" y="0" width="457" height="18" uuid="b1a2c3d4-0003-0003-0001-000000000007"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["to provide each individual employed learner with all the tools of trades and consumables for their training and development;"]]></textFieldExpression>
			</textField>
		</band>
		<band height="26" splitType="Prevent">
			<staticText>
				<reportElement x="0" y="0" width="30" height="18" uuid="b1a2c3d4-0003-0002-0001-000000000008"/>
				<textElement verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<text><![CDATA[3.3.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="30" y="0" width="457" height="18" uuid="b1a2c3d4-0003-0003-0001-000000000008"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["to explain the contents and terms and conditions of this agreement to the employed learner and further give them sufficient time to read through it before signature and upon signature provide the employed learner with a copy and submit the proof of completions for the learner who completed the programme;"]]></textFieldExpression>
			</textField>
		</band>

		<!-- SECTION 4 -->
		<band height="60" splitType="Prevent">
			<staticText>
				<reportElement x="0" y="10" width="24" height="18" uuid="b1a2c3d4-0003-0002-0001-000000000009"/>
				<textElement verticalAlignment="Top">
					<font size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[4.]]></text>
			</staticText>
			<staticText>
				<reportElement x="24" y="10" width="463" height="18" uuid="b1a2c3d4-0003-0003-0001-000000000009"/>
				<textElement verticalAlignment="Top">
					<font size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[Right of Review]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="34" width="30" height="18" uuid="b1a2c3d4-0003-0002-0001-000000000010"/>
				<textElement verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<text><![CDATA[4.1.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="30" y="34" width="457" height="18" uuid="b1a2c3d4-0003-0003-0001-000000000010"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["The Host employer shall keep full records of all service provided in terms of this Agreement and shall retain such records for the duration of this Agreement ."]]></textFieldExpression>
			</textField>
		</band>
		<band height="26" splitType="Prevent">
			<staticText>
				<reportElement x="0" y="0" width="30" height="18" uuid="b1a2c3d4-0003-0002-0001-000000000011"/>
				<textElement verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<text><![CDATA[4.2.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="30" y="0" width="457" height="18" uuid="b1a2c3d4-0003-0003-0001-000000000011"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["If the MQA wishes to satisfy itself that the Service Provider is complying with all relevant statutory and regulatory provisions relevant to the provision of the services: or the MoA, as well as policies and procedures determined by the MQA from time to time in respect of the services or specific aspects thereof; the service Provider shall on seven (7) or more written days notice:"]]></textFieldExpression>
			</textField>
		</band>
		<band height="26" splitType="Prevent">
			<staticText>
				<reportElement x="18" y="0" width="38" height="18" uuid="b1a2c3d4-0003-0002-0001-000000000012"/>
				<textElement verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<text><![CDATA[4.2.1.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="56" y="0" width="431" height="18" uuid="b1a2c3d4-0003-0003-0001-000000000012"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["Participate in a restricted review to be conducted by an independent third party,"]]></textFieldExpression>
			</textField>
		</band>
		<band height="26" splitType="Prevent">
			<staticText>
				<reportElement x="18" y="0" width="38" height="18" uuid="b1a2c3d4-0003-0002-0001-000000000013"/>
				<textElement verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<text><![CDATA[4.2.2.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="56" y="0" width="431" height="18" uuid="b1a2c3d4-0003-0003-0001-000000000013"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["Provide an independent third part with reasonable information, documentation and access to personnel, premises and records as he may require in order to conduct the restricted review."]]></textFieldExpression>
			</textField>
		</band>
		<band height="26" splitType="Prevent">
			<staticText>
				<reportElement x="18" y="0" width="38" height="18" uuid="b1a2c3d4-0004-0002-0001-000000000001"/>
				<textElement verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<text><![CDATA[4.2.3.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="56" y="0" width="431" height="18" uuid="b1a2c3d4-0004-0003-0001-000000000001"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["The MQA shall bear the costs of the review"]]></textFieldExpression>
			</textField>
		</band>
		<band height="26" splitType="Prevent">
			<staticText>
				<reportElement x="18" y="0" width="38" height="18" uuid="b1a2c3d4-0004-0002-0001-000000000002"/>
				<textElement verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<text><![CDATA[4.2.4.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="56" y="0" width="431" height="18" uuid="b1a2c3d4-0004-0003-0001-000000000002"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["Should the review indicate the Service Provider is not in compliance with its obligations, the Service Provider will at its own costs, immediately initiate actions to ensure compliance."]]></textFieldExpression>
			</textField>
		</band>

		<!-- SECTION 5 -->
		<band height="60" splitType="Prevent">
			<staticText>
				<reportElement x="0" y="10" width="24" height="18" uuid="b1a2c3d4-0004-0002-0001-000000000003"/>
