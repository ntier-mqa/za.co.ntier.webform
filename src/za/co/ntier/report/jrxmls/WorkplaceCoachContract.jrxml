				</textElement>
				<text><![CDATA[For and on behalf of the HOST COMPANY,
duly authorised thereto]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="415" width="487" height="18" uuid="e5c69482-9e2c-4012-930d-d9e52ec48433"/>
