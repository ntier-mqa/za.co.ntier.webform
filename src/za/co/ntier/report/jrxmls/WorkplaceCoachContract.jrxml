				<text><![CDATA[Signed at ............................................. on this .................... day of ................................ 20......]]></text>
			</staticText>
			<line>
				<reportElement x="240" y="498" width="247" height="1" uuid="88bf305e-ea3e-4ee8-bb5a-a573d11e45f2"/>
				<graphicElement><pen lineWidth="1.0"/></graphicElement>
			</line>
			<staticText>
				<reportElement x="240" y="504" width="247" height="18" uuid="c977841d-bcb8-4a83-9c6f-233f01764b1f"/>
				<textElement verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[The COACH]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="540" width="487" height="18" uuid="e0485f34-beda-4f3a-bf14-b461979c580b"/>
				<textElement verticalAlignment="Middle">
					<font size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[MQA SIGNATURE]]></text>
