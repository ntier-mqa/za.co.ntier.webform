						<font size="10"/>
					</textElement>
					<textFieldExpression><![CDATA[$P{ContractData} != null && $P{ContractData}.get("EmployerContact") != null ? (String)$P{ContractData}.get("EmployerContact") : ($P{ContractData} != null && $P{ContractData}.get("EmployerTelephone") != null ? (String)$P{ContractData}.get("EmployerTelephone") : $P{EmployerContact})]]></textFieldExpression>
